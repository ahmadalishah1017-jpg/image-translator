# Public URL of the site (used for canonical URLs, sitemap and Open Graph tags)
NEXT_PUBLIC_SITE_URL=https://snaptranslate.example.com

# Translation provider: google | deepl | libretranslate | mymemory
# If unset, the first provider with credentials below is used, falling back to MyMemory (no key, low daily quota).
TRANSLATION_PROVIDER=

# Google Cloud Translation API (Basic / v2)
GOOGLE_TRANSLATE_API_KEY=

# DeepL API (free-tier keys end in ":fx")
DEEPL_API_KEY=

# LibreTranslate (self-hosted or hosted instance)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# MyMemory: optional contact email raises the anonymous daily quota
MYMEMORY_EMAIL=

# Requests per minute per IP to /api/translate (default 30)
TRANSLATE_RATE_LIMIT_PER_MINUTE=30
